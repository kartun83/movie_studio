{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.kartun.moviestudio.moviestudiohrui",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "fallbackLocale": "en",
      "supportedLocales": [
        "en",
        "es",
        "ru"
      ]
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.18.3",
      "toolsId": "4c9a3b20-a85d-4efe-b1b7-4e6b52ab1732"
    },
    "dataSources": {
      "mainService": {
        "uri": "/hr/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "moviestudio_assets_ui-display": {
          "semanticObject": "moviestudio_assets_ui",
          "action": "display",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.138.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.kartun.moviestudio.moviestudiohrui.i18n.i18n",
          "supportedLocales": [
            "",
            "en"
          ]
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            "",
            "en"
          ]
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PersonList",
          "target": "PersonList"
        },
        {
          "pattern": "Person({key}):?query:",
          "name": "PersonObjectPage",
          "target": "PersonObjectPage"
        }
      ],
      "targets": {
        "PersonList": {
          "type": "Component",
          "id": "PersonList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Person",
              "variantManagement": "Page",
              "navigation": {
                "Person": {
                  "detail": {
                    "route": "PersonObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "PersonObjectPage": {
          "type": "Component",
          "id": "PersonObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Person"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "movie_studio_mta"
  }
}