_schema-version: 3.3.0
ID: movie_studio_mta
description: Movie studio applcation
version: 1.0.8
modules:

- name: movie_studio_mta-srv
  type: nodejs
  path: gen/srv
  requires:
  - name: movie_studio_mta-db
  - name: movie_studio_mta-uaa
  - name: movie_studio_mta-destination-service
  - name: movie-studio-ias-app
    parameters:
      config: 
        credential-type: X509_GENERATED
  provides:
  - name: srv-api
    properties:
      srv-url: ${default-url}
  parameters:
    buildpack: nodejs_buildpack
    instances: 1
    memory: 128M
  build-parameters:
    builder: npm-ci

- name: movie_studio_mta-db-deployer
  type: hdb
  path: gen/db
  requires:
  - name: movie_studio_mta-db
  parameters:
    memory: 128M

- name: movie_studio_mta-destination-content
  type: com.sap.application.content
  requires:
  - name: movie_studio_mta-uaa
  - name: movie_studio_mta-repo-host
  - name: movie_studio_mta-destination-service
    parameters:
      content-target: true
  parameters:
    content:
      instance:
        destinations:
        - Name: movie_studio_mta_html_repo_host
          ServiceInstanceName: movie_studio_mta-repo-host
          ServiceKeyName: movie_studio_mta-repo-host-key
          sap.cloud.service: movie_studio_mta
        - Authentication: OAuth2UserTokenExchange
          Name: movie_studio_mta-uaa
          ServiceInstanceName: movie_studio_mta-uaa
          ServiceKeyName: movie_studio_mta-uaa-key
          sap.cloud.service: movie_studio_mta

        existing_destinations_policy: update
  build-parameters:
    no-source: true

- name: movie_studio_mta-app-content
  type: com.sap.application.content
  path: .
  requires:
  - name: movie_studio_mta-repo-host
    parameters:
      content-target: true
  build-parameters:
    build-result: resources
    requires:
    - artifacts:
      - nsmoviestuidioui.zip
      name: nsmoviestuidioui
      target-path: resources/
    - artifacts:
      - comkartunmoviestudiomoviestudioassetsui.zip
      name: comkartunmoviestudiomoviestudioassetsui
      target-path: resources/    
    - artifacts:
      - comkartunmoviestudiomoviestudiohrui.zip
      name: comkartunmoviestudiomoviestudiohrui
      target-path: resources/

- name: nsmoviestuidioui
  type: html5
  path: app/movie_stuidio_ui
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []

- name: comkartunmoviestudiomoviestudioassetsui
  type: html5
  path: app/moviestudio_assets_ui
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []

- name: comkartunmoviestudiomoviestudiohrui
  type: html5
  path: app/movie_studio_hr_ui
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []

resources:

- name: movie-studio-ias-app
  type: org.cloudfoundry.managed-service
  requires:
    - name: srv-api
  parameters:
    service: identity
    service-name: ${space}-movie-studio-ias-app
    service-plan: application
    config:
      display-name: MovieStudio-${space}-${org}
      oauth2-configuration:
        redirect-uris:
          - ~{srv-api/srv-url}/login/callback?authType=ias
        post-logout-redirect-uris: 
          - ~{srv-api/srv-url}/logout/**
        grant-types: ["authorization_code"]
        credential-types: ["binding-secret","x509"]
      xsuaa-cross-consumption: false
      multi-tenant: false

- name: movie_studio_mta-db
  type: com.sap.xs.hdi-container
  parameters:
    service: hana
    service-plan: hdi-shared

- name: movie_studio_mta-destination-service
  type: org.cloudfoundry.managed-service
  parameters:
    config:
      HTML5Runtime_enabled: true
      init_data:
        instance:
          destinations:
          - Authentication: NoAuthentication
            HTML5.DynamicDestination: true
            HTML5.ForwardAuthToken: true
            Name: srv-api
            ProxyType: Internet
            Type: HTTP
            URL: ~{srv-api/srv-url}
          - Authentication: NoAuthentication
            Name: ui5
            ProxyType: Internet
            Type: HTTP
            URL: https://ui5.sap.com
          existing_destinations_policy: update
      version: 1.0.0
    service: destination
    service-name: movie_studio_mta-destination-service
    service-plan: lite
  requires:
  - name: srv-api

- name: movie_studio_mta-repo-host
  type: org.cloudfoundry.managed-service
  parameters:
    service: html5-apps-repo
    service-keys:
    - name: movie_studio_mta-repo-host-key
    service-plan: app-host

- name: movie_studio_mta-uaa
  type: org.cloudfoundry.managed-service
  parameters:
    config:
      tenant-mode: dedicated
      xsappname: movie_studio_mta-${org}-${space}
    path: ./xs-security.json
    service: xsuaa
    service-keys:
    - name: movie_studio_mta-uaa-key
    service-plan: application

- name: movie_studio_mta-html5-runtime
  type: org.cloudfoundry.managed-service
  parameters:
    service: html5-apps-repo
    service-plan: app-runtime

parameters:
  deploy_mode: html5-repo
  enable-parallel-deployments: true

build-parameters:
  before-all:
  - builder: custom
    commands:
    - npm ci
    - npx cds build --production
