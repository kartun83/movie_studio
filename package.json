{
  "name": "movie_studio",
  "version": "1.1.5",
  "description": "Movie studio management app.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "@sap/xsenv": "^5.6.1",
    "@sap/xssec": "^4",
    "express": "^4",
    "passport": "^0.7.0",
    "@sap/approuter": "latest",
    "mbt": "latest"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.3.0",
    "@cap-js/cds-types": "^0.10.0",
    "@cap-js/sqlite": "^2.0.1",
    "@sap/cds-dk": "^9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "axios": "^1.10.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "chai-subset": "^1.6.0",
    "jest": "^30.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "mbt": "latest",
    "cds-plugin-ui5": "^0.9.3",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "jest --detectOpenHandles --forceExit",
    "start_ts": "cds watch --profile ts",
    "start_hybrid": "cds watch --profile hybrid --profile ts",
    "start:sqlite-mock": "cds watch --profile sqlite-mock",
    "start:hana-mock": "cds watch --profile db-hybrid-uaa-mock",
    "start:ias": "cds watch --profile ias",
    "start:ias-real": "cds watch --profile ias-real",
    "start:approuter_standalone": "cds bind --exec -- npm start --prefix app/router",
    "start:approuter_managed": "node node_modules/@sap/approuter/approuter.js",
    "mta_build": "mbt build",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy.ps1",
    "build:deploy": "npm run mta_build && npm run deploy",
    "build:deploy:win": "npm run mta_build && npm run deploy:win",
    "deploy_hana": "cds deploy --to hana",
    "deploy_hana_hybrid": "cds deploy --to hana --profile hybrid",
    "cds_compile_xsua": "cds compile srv/ --to xsuaa > xs-security.json",
    "watch-movie_stuidio_ui": "cds watch --open com.kartun.movie_studio/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy movie_studio_mta --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "watch-moviestudio_assets_ui": "cds watch --open com.kartun.moviestudio.moviestudioassetsui/index.html?sap-ui-xx-viewCache=false --livereload false",    
    "watch-movie_studio_hr_ui": "cds watch --open com.kartun.moviestudio.moviestudiohrui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "auth": {
        "[production]": "xsuaa",
        "[development]": "mocked"
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "incident.support@tester.sap.com": {
              "password": "initial",
              "roles": [
                "support"
              ]
            },
            "admin": {
              "password": "",
              "roles": [
                "support",
                "authenticated-user"
              ]
            }
          }
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-runtime": true,
      "workzone": true
    },
    "sql": {
      "native_hana_associations": false
    },
    "odata": {
      "log": "debug"
    },
    "language": "ts",
    "profile": "hybrid"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/movie_stuidio_ui",
    "app/moviestudio_assets_ui",    
    "app/movie_studio_hr_ui"
  ]
}
